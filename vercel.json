{
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "buildCommand": "cd frontend && npm ci && npm run build && cd .. && mkdir -p public && cp -r frontend/dist/* public/",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
